# 1. Update the template
cat > layouts/sitemap.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <!-- HOMEPAGE -->
  <url>
    <loc>https://ahbeefabrication.com.au/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- SECTION PAGES (like /designs/, /gallery/) -->
  {{- range where .Site.Sections "Type" "not in" (slice "search" "404") -}}
  {{- if and (ne .Type "search") (ne .Type "404") (not .Draft) -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero -}}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end -}}
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {{- end -}}
  {{- end -}}

  <!-- REGULAR PAGES -->
  {{- range where .Site.RegularPages "Type" "not in" (slice "search" "404") -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero -}}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end -}}
    {{- with .Sitemap.ChangeFreq -}}
    <changefreq>{{ . }}</changefreq>
    {{- else -}}
    <changefreq>weekly</changefreq>
    {{- end -}}
    {{- with .Sitemap.Priority -}}
    <priority>{{ . }}</priority>
    {{- else -}}
    <priority>0.5</priority>
    {{- end -}}
  </url>
  {{- end -}}
</urlset>
EOF

# 2. Rebuild
rm -rf public/*
hugo --gc --minify

# 3. Verify designs page is now included
grep "designs" public/sitemap.xml

# 4. Count total URLs
grep -c '<url>' public/sitemap.xml

# 5. List all URLs
grep -o 'https://[^<]*' public/sitemap.xml